#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community App: Homebox
# Runs the Homebox server
# ==============================================================================
declare log_level
declare option
declare value

export HBOX_MODE="production"

# Only ever listen on loopback; NGINX is what faces Ingress and the network.
export HBOX_WEB_HOST="127.0.0.1"
export HBOX_WEB_PORT="47745"

# The database, and the directory underneath it that the attachments go in.
# Homebox resolves the storage prefix against the root of the filesystem, which
# is what puts it in this app's data directory rather than next to the binary.
export HBOX_DATABASE_DRIVER="sqlite3"
export HBOX_DATABASE_SQLITE_PATH="/data/homebox/homebox.db?_pragma=busy_timeout=2000&_pragma=journal_mode=WAL&_fk=1&_time_format=sqlite"
export HBOX_STORAGE_CONN_STRING="file:///?no_tmp_dir=true"
export HBOX_STORAGE_PREFIX_PATH="data/homebox/storage"

# Everything reaching Homebox has come through the NGINX in front of it, which
# is what puts the address it came from in the forwarded headers. Without this,
# the rate limiting on the login form would see every attempt as coming from
# loopback, and one person getting their password wrong would lock out the
# whole house.
export HBOX_OPTIONS_TRUST_PROXY="true"

# Updates to this app arrive through the Home Assistant app store, so the
# banner offering the ones published upstream is both wrong here and an
# outbound request nobody asked for.
export HBOX_OPTIONS_GITHUB_RELEASE_CHECK="false"

# Kept out of the database on purpose; see the init script that makes it.
HBOX_AUTH_API_KEY_PEPPER=$(</data/homebox/api_key_pepper)
export HBOX_AUTH_API_KEY_PEPPER

# Scheduled and remote backups. The key seals the stored destination
# credentials; see the init script that makes it.
HBOX_BACKUP_ENCRYPTION_KEY=$(</data/homebox/backup_encryption_key)
export HBOX_BACKUP_ENCRYPTION_KEY
export HBOX_BACKUP_LOCAL_ROOT="/data/homebox/backups"

# Homebox has fewer levels of its own, and spells "warning" differently.
log_level="info"
case "$(bashio::string.lower "$(bashio::config 'log_level' 'info')")" in
    trace)              log_level="trace" ;;
    debug)              log_level="debug" ;;
    info|notice)        log_level="info" ;;
    warning)            log_level="warn" ;;
    error)              log_level="error" ;;
    fatal)              log_level="fatal" ;;
esac
export HBOX_LOG_LEVEL="${log_level}"

# The address this app is reached at from the outside. Homebox has no way of
# working it out on its own, and uses it for the links in the mail it sends.
if bashio::config.has_value 'base_url'; then
    HBOX_OPTIONS_HOSTNAME=$(bashio::config 'base_url')
    export HBOX_OPTIONS_HOSTNAME
fi

HBOX_OPTIONS_ALLOW_REGISTRATION=$(bashio::config 'allow_registration' 'true')
export HBOX_OPTIONS_ALLOW_REGISTRATION

HBOX_OPTIONS_AUTO_INCREMENT_ASSET_ID=$(bashio::config 'auto_increment_asset_id' 'true')
export HBOX_OPTIONS_AUTO_INCREMENT_ASSET_ID

HBOX_WEB_MAX_UPLOAD_SIZE=$(bashio::config 'max_upload_size' '10')
export HBOX_WEB_MAX_UPLOAD_SIZE

# Without these, a forgotten password has no way out of the house.
if bashio::config.has_value 'smtp_host'; then
    HBOX_MAILER_HOST=$(bashio::config 'smtp_host')
    HBOX_MAILER_PORT=$(bashio::config 'smtp_port' '587')
    HBOX_MAILER_FROM=$(bashio::config 'smtp_from')
    HBOX_MAILER_USERNAME=$(bashio::config 'smtp_user')
    HBOX_MAILER_PASSWORD=$(bashio::config 'smtp_password')
    export HBOX_MAILER_HOST HBOX_MAILER_PORT HBOX_MAILER_FROM \
        HBOX_MAILER_USERNAME HBOX_MAILER_PASSWORD
fi

# AI assistants (Claude, ChatGPT, Cursor, ...) working with the inventory over
# the Model Context Protocol. Off unless asked for. Each collection's owner still
# has to allow it inside Homebox, and these two only ever narrow what is allowed.
if bashio::config.true 'mcp_enabled'; then
    export HBOX_MCP_ENABLED="true"
    HBOX_MCP_ALLOW_WRITES=$(bashio::config 'mcp_allow_writes' 'true')
    HBOX_MCP_ALLOW_DELETE=$(bashio::config 'mcp_allow_delete' 'false')
    export HBOX_MCP_ALLOW_WRITES HBOX_MCP_ALLOW_DELETE
fi

HBOX_OPTIONS_ALLOW_LOCAL_LOGIN=$(bashio::config 'allow_local_login' 'true')
export HBOX_OPTIONS_ALLOW_LOCAL_LOGIN

# Single sign-on through an OpenID Connect provider. The optional settings are
# only passed on when set, so Homebox keeps its own defaults for the rest.
if bashio::config.true 'oidc_enabled'; then
    bashio::config.require 'oidc_issuer_url' 'The OIDC issuer URL is required'
    bashio::config.require 'oidc_client_id' 'The OIDC client ID is required'
    bashio::config.require 'oidc_client_secret' 'The OIDC client secret is required'

    export HBOX_OIDC_ENABLED="true"
    HBOX_OIDC_ISSUER_URL=$(bashio::config 'oidc_issuer_url')
    HBOX_OIDC_CLIENT_ID=$(bashio::config 'oidc_client_id')
    HBOX_OIDC_CLIENT_SECRET=$(bashio::config 'oidc_client_secret')
    export HBOX_OIDC_ISSUER_URL HBOX_OIDC_CLIENT_ID HBOX_OIDC_CLIENT_SECRET

    if bashio::config.has_value 'oidc_scope'; then
        HBOX_OIDC_SCOPE=$(bashio::config 'oidc_scope')
        export HBOX_OIDC_SCOPE
    fi
    if bashio::config.has_value 'oidc_allowed_groups'; then
        HBOX_OIDC_ALLOWED_GROUPS=$(bashio::config 'oidc_allowed_groups')
        export HBOX_OIDC_ALLOWED_GROUPS
    fi
    if bashio::config.has_value 'oidc_group_claim'; then
        HBOX_OIDC_GROUP_CLAIM=$(bashio::config 'oidc_group_claim')
        export HBOX_OIDC_GROUP_CLAIM
    fi
    if bashio::config.has_value 'oidc_email_claim'; then
        HBOX_OIDC_EMAIL_CLAIM=$(bashio::config 'oidc_email_claim')
        export HBOX_OIDC_EMAIL_CLAIM
    fi
    if bashio::config.has_value 'oidc_name_claim'; then
        HBOX_OIDC_NAME_CLAIM=$(bashio::config 'oidc_name_claim')
        export HBOX_OIDC_NAME_CLAIM
    fi
    if bashio::config.has_value 'oidc_auto_redirect'; then
        HBOX_OIDC_AUTO_REDIRECT=$(bashio::config 'oidc_auto_redirect')
        export HBOX_OIDC_AUTO_REDIRECT
    fi
    if bashio::config.has_value 'oidc_verify_email'; then
        HBOX_OIDC_VERIFY_EMAIL=$(bashio::config 'oidc_verify_email')
        export HBOX_OIDC_VERIFY_EMAIL
    fi
fi

# OAuth apps for the cloud-drive backup destinations. A drive is only offered
# inside Homebox when both its client ID and secret are set.
declare -A backup_options=(
    [backup_google_client_id]=HBOX_BACKUP_GOOGLE_CLIENT_ID
    [backup_google_client_secret]=HBOX_BACKUP_GOOGLE_CLIENT_SECRET
    [backup_microsoft_client_id]=HBOX_BACKUP_MICROSOFT_CLIENT_ID
    [backup_microsoft_client_secret]=HBOX_BACKUP_MICROSOFT_CLIENT_SECRET
    [backup_microsoft_tenant]=HBOX_BACKUP_MICROSOFT_TENANT
    [backup_dropbox_client_id]=HBOX_BACKUP_DROPBOX_CLIENT_ID
    [backup_dropbox_client_secret]=HBOX_BACKUP_DROPBOX_CLIENT_SECRET
    [backup_allow_custom_endpoints]=HBOX_BACKUP_ALLOW_CUSTOM_ENDPOINTS
)
for option in "${!backup_options[@]}"; do
    if bashio::config.has_value "${option}"; then
        value=$(bashio::config "${option}")
        export "${backup_options[${option}]}=${value}"
    fi
done

bashio::log.info "Starting Homebox..."

exec homebox
